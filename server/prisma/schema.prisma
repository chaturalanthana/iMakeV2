  @@index([tenantId])
  @@index([reconciliationId])
  @@index([statementLineId])
  @@index([journalLineId])
  @@map("bank_reconciliation_matches")
}

model ProductGroup {
  id            String         @id @default(uuid())
  tenantId      String         @map("tenant_id")
  name          String
  parentId      String?        @map("parent_id")
  parent        ProductGroup?  @relation("GroupHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subGroups     ProductGroup[] @relation("GroupHierarchy")
  products      Product[]      @relation("ProductToProductGroup")
  standardYieldPercent  Decimal @default(98) @map("standard_yield_percent") @db.Decimal(9, 4)
  standardScrapPercent  Decimal @default(2) @map("standard_scrap_percent") @db.Decimal(9, 4)
  abnormalLossThreshold Decimal @default(2) @map("abnormal_loss_threshold") @db.Decimal(9, 4)
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("product_groups")
}

// Shop-floor work orders. Routing is versioned with the BOM (one header per BOM version).
// Work orders snapshot components and operations. Legacy production jobs and production
// orders stay in place and point at a work order so existing screens keep their APIs.

model Routing {
  id         String             @id @default(uuid())
  tenantId   String             @map("tenant_id")
  bomId      String             @unique @map("bom_id")
  code       String
  version    String
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bom        BOM                @relation(fields: [bomId], references: [id], onDelete: Cascade)
  operations RoutingOperation[]
  workOrders WorkOrder[]

  @@index([tenantId])
  @@map("routings")
}

model RoutingOperation {
  id                      String       @id @default(uuid())
  tenantId                String       @map("tenant_id")
  routingId               String       @map("routing_id")
  sequence                Int
  name                    String
  workstationId           String?      @map("workstation_id")
  setupMinutes            Decimal      @default(0) @map("setup_minutes") @db.Decimal(19, 4)
  runMinutesPerUnit       Decimal      @default(0) @map("run_minutes_per_unit") @db.Decimal(19, 4)
  noOfWorkers             Int          @default(1) @map("no_of_workers")
  isSubcontract           Boolean      @default(false) @map("is_subcontract")
  subcontractCostPerUnit  Decimal      @default(0) @map("subcontract_cost_per_unit") @db.Decimal(19, 4)
  milestoneWeight         Decimal      @default(0) @map("milestone_weight") @db.Decimal(9, 4)
  instructions            String?

  tenant                  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  routing                 Routing      @relation(fields: [routingId], references: [id], onDelete: Cascade)
  workstation             Workstation? @relation(fields: [workstationId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([routingId])
  @@map("routing_operations")
}

model WorkOrder {
  id                   String                   @id @default(uuid())
  tenantId             String                   @map("tenant_id")
  orderNumber          String                   @map("order_number")
  productId            String                   @map("product_id")
  bomId                String?                  @map("bom_id")
  routingId            String?                  @map("routing_id")
  warehouseId          String?                  @map("warehouse_id")
  quantity             Decimal                  @db.Decimal(19, 4)
  quantityCompleted    Decimal                  @default(0) @map("quantity_completed") @db.Decimal(19, 4)
  quantityScrapped     Decimal                  @default(0) @map("quantity_scrapped") @db.Decimal(19, 4)
  quantityRework       Decimal                  @default(0) @map("quantity_rework") @db.Decimal(19, 4)
  quantityReceipted    Decimal                  @default(0) @map("quantity_receipted") @db.Decimal(19, 4)
  status               String                   @default("CREATED")
  priority             String                   @default("MEDIUM")
  issueMode            String                   @default("BACKFLUSH") @map("issue_mode")
  startDate            DateTime?                @map("start_date")
  endDate              DateTime?                @map("end_date")
  assignedTo           String?                  @map("assigned_to")
  notes                String?
  sourceType           String                   @default("MANUAL") @map("source_type")
  sourceId             String?                  @map("source_id")
  salesOrderId         String?                  @map("sales_order_id")
  salesOrderItemId     String?                  @map("sales_order_item_id")
  legacyJobId          String?                  @unique @map("legacy_job_id")
  legacyOrderId        String?                  @unique @map("legacy_order_id")
  labourRatePerHour    Decimal                  @default(0) @map("labour_rate_per_hour") @db.Decimal(19, 4)
  overheadPercent      Decimal                  @default(0) @map("overhead_percent") @db.Decimal(19, 4)
  plannedMaterialCost  Decimal                  @default(0) @map("planned_material_cost") @db.Decimal(19, 4)
  plannedLabourCost    Decimal                  @default(0) @map("planned_labour_cost") @db.Decimal(19, 4)
  plannedMachineCost   Decimal                  @default(0) @map("planned_machine_cost") @db.Decimal(19, 4)
  plannedOverheadCost  Decimal                  @default(0) @map("planned_overhead_cost") @db.Decimal(19, 4)
  plannedScrapCost     Decimal                  @default(0) @map("planned_scrap_cost") @db.Decimal(19, 4)
  plannedSubcontractCost Decimal                @default(0) @map("planned_subcontract_cost") @db.Decimal(19, 4)
  actualMaterialCost   Decimal                  @default(0) @map("actual_material_cost") @db.Decimal(19, 4)
  actualLabourCost     Decimal                  @default(0) @map("actual_labour_cost") @db.Decimal(19, 4)
  actualMachineCost    Decimal                  @default(0) @map("actual_machine_cost") @db.Decimal(19, 4)
  actualOverheadCost   Decimal                  @default(0) @map("actual_overhead_cost") @db.Decimal(19, 4)
  actualScrapCost      Decimal                  @default(0) @map("actual_scrap_cost") @db.Decimal(19, 4)
  actualSubcontractCost Decimal                 @default(0) @map("actual_subcontract_cost") @db.Decimal(19, 4)
  tecoAt               DateTime?                @map("teco_at")
  closeDueAt           DateTime?                @map("close_due_at")
  shortClosed          Boolean                  @default(false) @map("short_closed")
  costCenterId         String?                  @map("cost_center_id")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")
  createdBy            String?                  @map("created_by")

  tenant               Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  costCenter           OrgCenter?               @relation("WorkOrderCostCenter", fields: [costCenterId], references: [id], onDelete: SetNull)
  product              Product                  @relation("WorkOrderProduct", fields: [productId], references: [id])
  bom                  BOM?                     @relation(fields: [bomId], references: [id], onDelete: SetNull)
  routing              Routing?                 @relation(fields: [routingId], references: [id], onDelete: SetNull)
  warehouse            Warehouse?               @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  salesOrder           SalesOrder?              @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  salesOrderItem       SalesOrderItem?          @relation("WorkOrderSalesItem", fields: [salesOrderItemId], references: [id], onDelete: SetNull)
  legacyJob            ProductionJob?           @relation(fields: [legacyJobId], references: [id], onDelete: Cascade)
  legacyOrder          ProductionOrder?         @relation(fields: [legacyOrderId], references: [id], onDelete: Cascade)
  components           WorkOrderComponent[]
  operations           WorkOrderOperation[]
  reservations         MaterialReservation[]
  issues               WorkOrderIssue[]
  confirmations        WorkOrderConfirmation[]
  plannedOrders        PlannedProductionOrder[]
  machineCaptures      MachineCapture[]
  genealogy            BatchGenealogy[]
  abnormalLosses       AbnormalLoss[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([productId])
  @@index([status])
  @@map("work_orders")
}

model WorkOrderComponent {
  id            String                @id @default(uuid())
  tenantId      String                @map("tenant_id")
  workOrderId   String                @map("work_order_id")
  productId     String                @map("product_id")
  quantityPer   Decimal               @map("quantity_per") @db.Decimal(19, 4)
  scrapPercent  Decimal               @default(0) @map("scrap_percent") @db.Decimal(19, 4)
  requiredQty   Decimal               @default(0) @map("required_qty") @db.Decimal(19, 4)
  reservedQty   Decimal               @default(0) @map("reserved_qty") @db.Decimal(19, 4)
  issuedQty     Decimal               @default(0) @map("issued_qty") @db.Decimal(19, 4)
  unitCost      Decimal               @default(0) @map("unit_cost") @db.Decimal(19, 4)
  costSource    String                @default("COST_PRICE") @map("cost_source")
  type          String                @default("Raw Material")
  instruction   String?

  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workOrder     WorkOrder             @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  product       Product               @relation(fields: [productId], references: [id])
  reservations  MaterialReservation[]
  issues        WorkOrderIssue[]

  @@index([tenantId])
  @@index([workOrderId])
  @@index([productId])
  @@map("work_order_components")
}

model WorkOrderOperation {
  id                     String                  @id @default(uuid())
  tenantId               String                  @map("tenant_id")
  workOrderId            String                  @map("work_order_id")
  sequence               Int
  name                   String
  workstationId          String?                 @map("workstation_id")
  setupMinutes           Decimal                 @default(0) @map("setup_minutes") @db.Decimal(19, 4)
  runMinutesPerUnit      Decimal                 @default(0) @map("run_minutes_per_unit") @db.Decimal(19, 4)
  noOfWorkers            Int                     @default(1) @map("no_of_workers")
  isSubcontract          Boolean                 @default(false) @map("is_subcontract")
  subcontractCostPerUnit Decimal                 @default(0) @map("subcontract_cost_per_unit") @db.Decimal(19, 4)
  milestoneWeight        Decimal                 @default(0) @map("milestone_weight") @db.Decimal(9, 4)
  machineRatePerHour     Decimal                 @default(0) @map("machine_rate_per_hour") @db.Decimal(19, 4)
  instructions           String?
  status                 String                  @default("PENDING")
  runningSince           DateTime?               @map("running_since")
  actualMachineMinutes   Decimal                 @default(0) @map("actual_machine_minutes") @db.Decimal(19, 4)
  yieldQty               Decimal                 @default(0) @map("yield_qty") @db.Decimal(19, 4)
  scrapQty               Decimal                 @default(0) @map("scrap_qty") @db.Decimal(19, 4)
  reworkQty              Decimal                 @default(0) @map("rework_qty") @db.Decimal(19, 4)

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workOrder              WorkOrder               @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  workstation            Workstation?            @relation(fields: [workstationId], references: [id], onDelete: SetNull)
  timeLogs               OperationTimeLog[]
  confirmations          WorkOrderConfirmation[]
  machineCaptures        MachineCapture[]

  @@index([tenantId])
  @@index([workOrderId])
  @@map("work_order_operations")
}

model MaterialReservation {
  id           String              @id @default(uuid())
  tenantId     String              @map("tenant_id")
  workOrderId  String              @map("work_order_id")
  componentId  String              @map("component_id")
  productId    String              @map("product_id")
  warehouseId  String?             @map("warehouse_id")
  quantity     Decimal             @db.Decimal(19, 4)
  consumedQty  Decimal             @default(0) @map("consumed_qty") @db.Decimal(19, 4)
  status       String              @default("OPEN")
  lotNumber    String?             @map("lot_number")
  serialNumber String?             @map("serial_number")
  createdAt    DateTime            @default(now()) @map("created_at")

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workOrder    WorkOrder           @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  component    WorkOrderComponent  @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([workOrderId])
  @@index([productId])
  @@map("material_reservations")
}

model WorkOrderIssue {
  id             String              @id @default(uuid())
  tenantId       String              @map("tenant_id")
  workOrderId    String              @map("work_order_id")
  componentId    String?             @map("component_id")
  confirmationId String?             @map("confirmation_id")
  productId      String              @map("product_id")
  issuedProductId String?            @map("issued_product_id")
  substitutionRatio Decimal          @default(1) @map("substitution_ratio") @db.Decimal(19, 4)
  substitutionDelta Decimal          @default(0) @map("substitution_delta") @db.Decimal(19, 4)
  quantity       Decimal             @db.Decimal(19, 4)
  unitCost       Decimal             @default(0) @map("unit_cost") @db.Decimal(19, 4)
  totalCost      Decimal             @default(0) @map("total_cost") @db.Decimal(19, 4)
  materialCost   Decimal             @default(0) @map("material_cost") @db.Decimal(19, 4)
  scrapCost      Decimal             @default(0) @map("scrap_cost") @db.Decimal(19, 4)
  mode           String              @default("MANUAL")
  lotNumber      String?             @map("lot_number")
  serialNumber   String?             @map("serial_number")
  createdAt      DateTime            @default(now()) @map("created_at")
  createdBy      String?             @map("created_by")

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workOrder      WorkOrder           @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  component      WorkOrderComponent? @relation(fields: [componentId], references: [id], onDelete: SetNull)
  issuedProduct  Product?            @relation("IssuedSubstitute", fields: [issuedProductId], references: [id], onDelete: SetNull)
  confirmation   WorkOrderConfirmation? @relation(fields: [confirmationId], references: [id], onDelete: SetNull)
  genealogy      BatchGenealogy[]

  @@index([tenantId])
  @@index([workOrderId])
