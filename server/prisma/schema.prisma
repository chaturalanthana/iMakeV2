  quantity         Decimal  @db.Decimal(19, 4)
  scrapPercent     Decimal  @default(0.0) @map("scrap_percent") @db.Decimal(19, 4)
  instruction      String?
  type             String   @default("Raw Material")
  
  bom              BOM      @relation(fields: [bomId], references: [id], onDelete: Cascade)
  componentProduct Product  @relation("BOMComponentProducts", fields: [productId], references: [id])
  alternates       BomAlternate[]

  @@index([tenantId])
  @@map("bom_items")
}

model BOMResource {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  bomId     String   @map("bom_id")
  fileName  String   @map("file_name")
  filePath  String   @map("file_path")
  fileType  String   @map("file_type")
  fileSize  Int      @map("file_size")
  createdAt DateTime @default(now()) @map("created_at")
  
  bom       BOM      @relation(fields: [bomId], references: [id], onDelete: Cascade)

