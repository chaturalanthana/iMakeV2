model BankReconciliation {
  id                      String                    @id @default(uuid())
  tenantId                String                    @map("tenant_id")
  accountId               String                    @map("account_id")
  startDate               DateTime                  @map("start_date")
  endDate                 DateTime                  @map("end_date")
  statementClosingBalance Decimal                   @map("statement_closing_balance") @db.Decimal(19, 4)
  ledgerClosingBalance    Decimal                   @map("ledger_closing_balance") @db.Decimal(19, 4)
  status                  String                    @default("DRAFT") // DRAFT, COMPLETED
  reconciledAt            DateTime?                 @map("reconciled_at")
  reconciledBy            String?                   @map("reconciled_by")
  approvedBy              String?                   @map("approved_by")
  createdAt               DateTime                  @default(now()) @map("created_at")
  updatedAt               DateTime                  @updatedAt @map("updated_at")
  createdBy               String?                   @map("created_by")

  tenant                  Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account                 Account                   @relation(fields: [accountId], references: [id])
  statementLines          BankStatementLine[]
  matches                 BankReconciliationMatch[]

  @@index([tenantId])
  @@index([accountId])
  @@map("bank_reconciliations")
}

model BankStatementLine {
  id                 String                    @id @default(uuid())
  tenantId           String                    @map("tenant_id")
  bankReconciliationId String?                 @map("bank_reconciliation_id")
  accountId          String                    @map("account_id")
  date               DateTime
  reference          String?
  chequeNumber       String?                   @map("cheque_number")
  description        String?
  amount             Decimal                   @db.Decimal(19, 4)
  isMatched          Boolean                   @default(false) @map("is_matched")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")

  tenant             Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account            Account                   @relation(fields: [accountId], references: [id])
  reconciliation     BankReconciliation?       @relation(fields: [bankReconciliationId], references: [id], onDelete: SetNull)
  matches            BankReconciliationMatch[]

  @@index([tenantId])
  @@index([accountId])
  @@index([bankReconciliationId])
  @@map("bank_statement_lines")
}

model BankReconciliationMatch {
  id               String             @id @default(uuid())
  tenantId         String             @map("tenant_id")
  reconciliationId String             @map("reconciliation_id")
  statementLineId  String             @map("statement_line_id")
  journalLineId    String             @map("journal_line_id")
  matchType        String             @default("MANUAL") @map("match_type") // AUTO, MANUAL
  confidenceScore  Int                @default(100) @map("confidence_score")
  createdAt        DateTime           @default(now()) @map("created_at")

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reconciliation   BankReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  statementLine    BankStatementLine  @relation(fields: [statementLineId], references: [id], onDelete: Cascade)
  journalLine      JournalLine        @relation(fields: [journalLineId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([reconciliationId])
  @@index([statementLineId])
  @@index([journalLineId])
  @@map("bank_reconciliation_matches")
}

model ProductGroup {
