generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                    String                 @id @default(uuid())
  name                  String
  slug                  String                 @unique
  address               String?
  phone                 String?
  email                 String?
  currency              String                 @default("USD")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  accounts              Account[]
  companyHolidays       CompanyHoliday[]
  currencies            Currency[]
  customerCategories    CustomerCategory[]
  customers             Customer[]
  discountGroupProducts DiscountGroupProduct[]
  discountGroups        DiscountGroup[]
  employeeLoans         EmployeeLoan[]
  employees             Employee[]
  goodsIssues           GoodsIssue[]
  grns                  GRN[]
  hrAdditions           HrAddition[]
  hrDeductions          HrDeduction[]
  journalEntries        JournalEntry[]
  leaveApplications     LeaveApplication[]
  leaveTypes            LeaveType[]
  paymentReceipts       PaymentReceipt[]
  paymentVouchers       PaymentVoucher[]
  priceListPrices       PriceListPrice[]
  priceLists            PriceList[]
  productTypes          ProductType[]
  products              Product[]
  productGroups         ProductGroup[]
  purchaseOrders        PurchaseOrder[]
  purchaseRequisitions  PurchaseRequisition[]
  stockReceipts         StockReceipt[]
  stockTransfers        StockTransfer[]
  roles                 Role[]
  salaryRuns            SalaryRun[]
  salesDeliveries       SalesDelivery[]
  salesInvoices         SalesInvoice[]
  salesOrders           SalesOrder[]
  salesQuotations       SalesQuotation[]
  stockAdjustments      StockAdjustment[]
  stockMovements        StockMovement[]
  suppliers             Supplier[]
  taxGroups             TaxGroup[]
  taxSlabs              TaxSlab[]
  users                 User[]
  warehouses            Warehouse[]
  paymentTerms          PaymentTerm[]
  purchaseTaxGroups     PurchaseTaxGroup[]
  purchaseTaxSlabs      PurchaseTaxSlab[]
  purchaseWithholdingTaxGroups PurchaseWithholdingTaxGroup[]
  purchaseWithholdingTaxSlabs  PurchaseWithholdingTaxSlab[]
  boms                         BOM[]
  shiftPatterns                ShiftPattern[]
  productionCalendarEvents     ProductionCalendarEvent[]
  productionJobs               ProductionJob[]
  productionOrders             ProductionOrder[]
  workstations                 Workstation[]
  machines                     Machine[]
  bankReconciliations          BankReconciliation[]
  bankStatementLines           BankStatementLine[]
  bankReconciliationMatches    BankReconciliationMatch[]

  @@map("tenants")
}

model Role {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  permissions Json     @default("{}")
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       User[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

model User {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  createdBy    String?  @map("created_by")
  firstName    String?  @map("first_name")
  lastName     String?  @map("last_name")
  roleId       String?  @map("role_id")
  status       String   @default("ACTIVE")
  role         Role?            @relation(fields: [roleId], references: [id])
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  preferences  UserPreference[]

  @@index([tenantId])
  @@map("users")
}

model UserPreference {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  key       String
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([tenantId])
  @@map("user_preferences")
}

model Customer {
  id                   String            @id @default(uuid())
  tenantId             String            @map("tenant_id")
  code                 String
  name                 String
  email                String?
  phone                String?
  address              String?
  creditLimit          Decimal           @default(0.0) @map("credit_limit") @db.Decimal(19, 4)
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  createdBy            String?           @map("created_by")
  activeStatus         String?           @default("ACTIVE") @map("active_status")
  branches             Json?             @default("[]")
  creditCustomer       Boolean?          @default(false) @map("credit_customer")
  creditPeriod         Int?              @default(0) @map("credit_period")
  customerCategory     String?           @map("customer_category")
  customerSegment      String?           @map("customer_segment")
  customerType         String?           @map("customer_type")
  industry             String?
  mobileNumber         String?           @map("mobile_number")
  priceList            String?           @map("price_list")
  salesRep             String?           @map("sales_rep")
  accountsReceivableId String?           @map("accounts_receivable_id")
  allowCreditSales     Boolean?          @default(false) @map("allow_credit_sales")
  customerCategoryId   String?           @map("customer_category_id")
  discountGroup        String?           @map("discount_group")
  revenueAccountId     String?           @map("revenue_account_id")
  salesTerritory       String?           @map("sales_territory")
  taxGroup             String?           @map("tax_group")
  accountsReceivable   Account?          @relation("CustomerARAccount", fields: [accountsReceivableId], references: [id])
  customerCategoryRel  CustomerCategory? @relation(fields: [customerCategoryId], references: [id])
  revenueAccount       Account?          @relation("CustomerRevenueAccount", fields: [revenueAccountId], references: [id])
  tenant               Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentReceipts      PaymentReceipt[]
  salesDeliveries      SalesDelivery[]
  salesInvoices        SalesInvoice[]
  salesOrders          SalesOrder[]
  salesQuotations      SalesQuotation[]

  @@index([tenantId])
  @@map("customers")
}

model Supplier {
  id               String           @id @default(uuid())
  tenantId         String           @map("tenant_id")
  code             String
  name             String
  email            String?
  phone            String?
  address          String?
  activeStatus     String?          @default("ACTIVE") @map("active_status")
  supplierCategory String?          @map("supplier_category")
  leadTime         Int?             @default(0) @map("lead_time")
  currency         String?          @default("USD")
  creditSupplier   Boolean?         @default(false) @map("credit_supplier")
  creditPeriod     Int?             @default(0) @map("credit_period")
  paymentTerms     String?          @map("payment_terms")
  supplierGroup    String?          @map("supplier_group")
  branches         Json?            @default("[]")
  bankDetails      Json?            @default("[]") @map("bank_details")
  accountsPayableId String?          @map("accounts_payable_id")
  advancePaymentAccountId String?    @map("advance_payment_account_id")
  withholdingTaxGroup String?        @map("withholding_tax_group")
  taxGroup         String?          @map("tax_group")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  createdBy        String?          @map("created_by")
  goodsIssues      GoodsIssue[]
  grns             GRN[]
  paymentVouchers  PaymentVoucher[]
  products         Product[]
  purchaseOrders   PurchaseOrder[]
  purchaseRequisitions PurchaseRequisition[]
  accountsPayable  Account?         @relation("SupplierAPAccount", fields: [accountsPayableId], references: [id])
  advancePaymentAccount Account?   @relation("SupplierAdvanceAccount", fields: [advancePaymentAccountId], references: [id])
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("suppliers")
}

model ProductCategory {
  id            String            @id @default(uuid())
  tenantId      String            @map("tenant_id")
  name          String
  parentId      String?           @map("parent_id")
  parent        ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subCategories ProductCategory[] @relation("CategoryHierarchy")
  products      Product[]

  @@index([tenantId])
  @@map("product_categories")
}

model ProductBrand {
  id        String         @id @default(uuid())
  tenantId  String         @map("tenant_id")
  name      String
  imageUrl  String?        @map("image_url")
  parentId  String?        @map("parent_id")
  parent    ProductBrand?  @relation("BrandHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subBrands ProductBrand[] @relation("BrandHierarchy")
  products  Product[]

  @@index([tenantId])
  @@map("product_brands")
}

model UnitOfMeasure {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  name             String
  purchaseProducts Product[] @relation("PurchaseUom")
  salesProducts    Product[] @relation("SalesUom")
  stockProducts    Product[] @relation("StockUom")
  products         Product[] @relation("Uom")

  @@unique([tenantId, name])
  @@map("unit_of_measures")
}

model Currency {
  id              String           @id @default(uuid())
  tenantId        String           @map("tenant_id")
  code            String
  symbol          String?
  name            String
  exchangeRate    Decimal          @default(1.0) @map("exchange_rate") @db.Decimal(19, 4)
  isBase          Boolean          @default(false) @map("is_base")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  grns            GRN[]
  products        Product[]
  purchaseOrders  PurchaseOrder[]
  purchaseRequisitions PurchaseRequisition[]
  salesInvoices   SalesInvoice[]
  salesOrders     SalesOrder[]
  salesQuotations SalesQuotation[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("currencies")
}

model Product {
  id                    String                 @id @default(uuid())
  tenantId              String                 @map("tenant_id")
  code                  String
  name                  String
  description           String?
  costPrice             Decimal                @default(0.0) @map("cost_price") @db.Decimal(19, 4)
  sellingPrice          Decimal                @default(0.0) @map("selling_price") @db.Decimal(19, 4)
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  createdBy             String?                @map("created_by")
  brandId               String?                @map("brand_id")
  categoryId            String?                @map("category_id")
  type                  String                 @default("PRODUCT")
  uomId                 String?                @map("uom_id")
  productTypeId         String?                @map("product_type_id")
  cpg                   String?
  currency              String                 @default("USD")
  hsCode                String?                @map("hs_code")
  isLocked              Boolean                @default(false) @map("is_locked")
  reorderLevel          Int                    @default(0) @map("reorder_level")
  subCategoryId         String?                @map("sub_category_id")
  supplierId            String?                @map("supplier_id")
  activeStatus          String?                @default("ACTIVE") @map("active_status")
  bomApplicable         Boolean?               @default(false) @map("bom_applicable")
  cogsAccountId         String?                @map("cogs_account_id")
  conversionFactor      Decimal?               @default(1.0) @map("conversion_factor") @db.Decimal(19, 4)
  costingMethod         String?                @default("FIFO") @map("costing_method")
  inventoryAccountId    String?                @map("inventory_account_id")
  productGroup          String?                @map("product_group")
  productGroupId        String?                @map("product_group_id")
  purchaseUomId         String?                @map("purchase_uom_id")
  safetyStock           Int?                   @default(0) @map("safety_stock")
  salesUomId            String?                @map("sales_uom_id")
  scrapPercent          Decimal?               @default(0.0) @map("scrap_percent") @db.Decimal(19, 4)
  standardCost          Decimal?               @default(0.0) @map("standard_cost") @db.Decimal(19, 4)
  stockUomId            String?                @map("stock_uom_id")
  taxGroup              String?                @map("tax_group")
  uomConversions        Json?                  @default("[]") @map("uom_conversions")
  currencyId            String?                @map("currency_id")
  discountGroupProducts DiscountGroupProduct[]
  giItems               GoodsIssueItem[]
  grnItems              GRNItem[]
  priceListPrices       PriceListPrice[]
  brand                 ProductBrand?          @relation(fields: [brandId], references: [id])
  category              ProductCategory?       @relation(fields: [categoryId], references: [id])
  productGroupRel       ProductGroup?          @relation("ProductToProductGroup", fields: [productGroupId], references: [id], onDelete: SetNull)
  cogsAccount           Account?               @relation("CogsAccount", fields: [cogsAccountId], references: [id])
  currencyRel           Currency?              @relation(fields: [currencyId], references: [id])
  inventoryAccount      Account?               @relation("InventoryAccount", fields: [inventoryAccountId], references: [id])
  productType           ProductType?           @relation(fields: [productTypeId], references: [id])
  purchaseUom           UnitOfMeasure?         @relation("PurchaseUom", fields: [purchaseUomId], references: [id])
  salesUom              UnitOfMeasure?         @relation("SalesUom", fields: [salesUomId], references: [id])
  stockUom              UnitOfMeasure?         @relation("StockUom", fields: [stockUomId], references: [id])
  supplier              Supplier?              @relation(fields: [supplierId], references: [id])
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uom                   UnitOfMeasure?         @relation("Uom", fields: [uomId], references: [id])
  poItems               PurchaseOrderItem[]
  prItems               PurchaseRequisitionItem[]
  stockReceiptItems     StockReceiptItem[]
  stockTransferItems    StockTransferItem[]
  deliveryItems         SalesDeliveryItem[]
  invoiceItems          SalesInvoiceItem[]
  orderItems            SalesOrderItem[]
  quotationItems        SalesQuotationItem[]
  adjItems              StockAdjustmentItem[]
  stockMovements        StockMovement[]
  boms                  BOM[]                  @relation("ProductBOMs")
  bomComponents         BOMItem[]              @relation("BOMComponentProducts")
  productionJobs        ProductionJob[]
  productionOrders      ProductionOrder[]      @relation("ProductProductionOrders")

  @@index([tenantId])
  @@map("products")
}

model Account {
  id                      String               @id @default(uuid())
  tenantId                String               @map("tenant_id")
  code                    String
  name                    String
  type                    String
  parentId                String?              @map("parent_id")
  createdAt               DateTime             @default(now()) @map("created_at")
  updatedAt               DateTime             @updatedAt @map("updated_at")
  createdBy               String?              @map("created_by")
  parent                  Account?             @relation("AccountHierarchy", fields: [parentId], references: [id])
  subAccounts             Account[]            @relation("AccountHierarchy")
  tenant                  Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryARAccounts      CustomerCategory[]   @relation("CategoryARAccount")
  categoryRevenueAccounts CustomerCategory[]   @relation("CategoryRevenueAccount")
  customerARAccounts      Customer[]           @relation("CustomerARAccount")
  customerRevenueAccounts Customer[]           @relation("CustomerRevenueAccount")
  supplierAPAccounts      Supplier[]           @relation("SupplierAPAccount")
  supplierAdvanceAccounts Supplier[]           @relation("SupplierAdvanceAccount")
  journalLines            JournalLine[]
  paymentReceiptLines     PaymentReceiptLine[]
  paymentReceipts         PaymentReceipt[]
  paymentVoucherLines     PaymentVoucherLine[]
  cogsProducts            Product[]            @relation("CogsAccount")
  inventoryProducts       Product[]            @relation("InventoryAccount")
  taxSlabs                TaxSlab[]            @relation("TaxSlabAccount")
  purchaseTaxSlabs        PurchaseTaxSlab[]    @relation("PurchaseTaxSlabAccount")
  purchaseWithholdingTaxSlabs PurchaseWithholdingTaxSlab[] @relation("PurchaseWithholdingTaxSlabAccount")
  bankReconciliations     BankReconciliation[]
  bankStatementLines      BankStatementLine[]

  @@index([tenantId])
  @@map("accounts")
}

model JournalEntry {
  id            String        @id @default(uuid())
  tenantId      String        @map("tenant_id")
  entryNumber   String        @map("entry_number")
  date          DateTime
  description   String
  referenceType String?       @map("reference_type")
  referenceId   String?       @map("reference_id")
  isPosted      Boolean       @default(false) @map("is_posted")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  createdBy     String?       @map("created_by")
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines         JournalLine[]

  @@index([tenantId])
  @@map("journal_entries")
}

model JournalLine {
  id             String       @id @default(uuid())
  journalEntryId String       @map("journal_entry_id")
  accountId      String       @map("account_id")
  debit          Decimal      @default(0.0) @db.Decimal(19, 4)
  credit         Decimal      @default(0.0) @db.Decimal(19, 4)
  description    String?
  account        Account      @relation(fields: [accountId], references: [id])
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  bankReconciliationMatches BankReconciliationMatch[]

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_lines")
}

model StockMovement {
  id            String     @id @default(uuid())
  tenantId      String     @map("tenant_id")
  productId     String     @map("product_id")
  type          String
  quantity      Decimal    @db.Decimal(19, 4)
  referenceType String?    @map("reference_type")
  referenceId   String?    @map("reference_id")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  createdBy     String?    @map("created_by")
  warehouseId   String?    @map("warehouse_id")
  product       Product    @relation(fields: [productId], references: [id])
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse     Warehouse? @relation(fields: [warehouseId], references: [id])

  @@index([tenantId])
  @@index([productId])
  @@map("stock_movements")
}

model SalesQuotation {
  id              String               @id @default(uuid())
  tenantId        String               @map("tenant_id")
  customerId      String               @map("customer_id")
  quotationNumber String               @map("quotation_number")
  date            DateTime
  status          String               @default("DRAFT")
  total           Decimal              @db.Decimal(19, 4)
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  createdBy       String?              @map("created_by")
  currencyId      String?              @map("currency_id")
  exchangeRate    Decimal              @default(1.0) @map("exchange_rate") @db.Decimal(19, 4)
  salesOrders     SalesOrder[]
  items           SalesQuotationItem[]
  currency        Currency?            @relation(fields: [currencyId], references: [id])
  customer        Customer             @relation(fields: [customerId], references: [id])
  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("sales_quotations")
}

model SalesQuotationItem {
  id          String         @id @default(uuid())
  quotationId String         @map("quotation_id")
  productId   String         @map("product_id")
  quantity    Decimal        @db.Decimal(19, 4)
  unitPrice   Decimal        @map("unit_price") @db.Decimal(19, 4)
  total       Decimal        @db.Decimal(19, 4)
  product     Product        @relation(fields: [productId], references: [id])
  quotation   SalesQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@index([productId])
  @@map("sales_quotation_items")
}

model SalesOrder {
  id            String           @id @default(uuid())
  tenantId      String           @map("tenant_id")
  customerId    String           @map("customer_id")
  quotationId   String?          @map("quotation_id")
  orderNumber   String           @map("order_number")
  date          DateTime
  status        String           @default("PENDING")
  total         Decimal          @db.Decimal(19, 4)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  createdBy     String?          @map("created_by")
  currencyId    String?          @map("currency_id")
  exchangeRate  Decimal          @default(1.0) @map("exchange_rate") @db.Decimal(19, 4)
  deliveries    SalesDelivery[]
  salesInvoices SalesInvoice[]
  items         SalesOrderItem[]
  currency      Currency?        @relation(fields: [currencyId], references: [id])
  customer      Customer         @relation(fields: [customerId], references: [id])
  quotation     SalesQuotation?  @relation(fields: [quotationId], references: [id])
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("sales_orders")
}

model SalesOrderItem {
  id        String     @id @default(uuid())
  orderId   String     @map("order_id")
  productId String     @map("product_id")
  quantity  Decimal    @db.Decimal(19, 4)
  unitPrice Decimal    @map("unit_price") @db.Decimal(19, 4)
  total     Decimal    @db.Decimal(19, 4)
  order     SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product    @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("sales_order_items")
}

model SalesDelivery {
  id             String              @id @default(uuid())
  tenantId       String              @map("tenant_id")
  customerId     String              @map("customer_id")
  orderId        String?             @map("order_id")
  deliveryNumber String              @map("delivery_number")
  date           DateTime
  status         String              @default("DELIVERED")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  createdBy      String?             @map("created_by")
  warehouseId    String?             @map("warehouse_id")
  customer       Customer            @relation(fields: [customerId], references: [id])
  order          SalesOrder?         @relation(fields: [orderId], references: [id])
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse      Warehouse?          @relation(fields: [warehouseId], references: [id])
  items          SalesDeliveryItem[]
  invoices       SalesInvoice[]

  @@index([tenantId])
  @@map("sales_deliveries")
}

model SalesDeliveryItem {
  id         String        @id @default(uuid())
  deliveryId String        @map("delivery_id")
  productId  String        @map("product_id")
  quantity   Decimal       @db.Decimal(19, 4)
  delivery   SalesDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  product    Product       @relation(fields: [productId], references: [id])

  @@index([deliveryId])
  @@index([productId])
  @@map("sales_delivery_items")
}

model SalesInvoice {
  id                  String               @id @default(uuid())
  tenantId            String               @map("tenant_id")
  customerId          String               @map("customer_id")
  orderId             String?              @map("order_id")
  invoiceNumber       String               @map("invoice_number")
  date                DateTime
  status              String               @default("UNPAID")
  total               Decimal              @db.Decimal(19, 4)
  amountPaid          Decimal              @default(0.0) @map("amount_paid") @db.Decimal(19, 4)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  createdBy           String?              @map("created_by")
  deliveryId          String?              @map("delivery_id")
  currencyId          String?              @map("currency_id")
  exchangeRate        Decimal              @default(1.0) @map("exchange_rate") @db.Decimal(19, 4)
  paymentReceiptLines PaymentReceiptLine[]
  paymentReceipts     PaymentReceipt[]
  items               SalesInvoiceItem[]
  currency            Currency?            @relation(fields: [currencyId], references: [id])
  customer            Customer             @relation(fields: [customerId], references: [id])
  delivery            SalesDelivery?       @relation(fields: [deliveryId], references: [id])
  order               SalesOrder?          @relation(fields: [orderId], references: [id])
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("sales_invoices")
}

model SalesInvoiceItem {
  id        String       @id @default(uuid())
  invoiceId String       @map("invoice_id")
  productId String       @map("product_id")
  quantity  Decimal      @db.Decimal(19, 4)
  unitPrice Decimal      @map("unit_price") @db.Decimal(19, 4)
  total     Decimal      @db.Decimal(19, 4)
  invoice   SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product   Product      @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
  @@map("sales_invoice_items")
}

model PurchaseOrder {
