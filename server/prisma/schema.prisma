  routingOperations   RoutingOperation[]
  workOrderOperations WorkOrderOperation[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("workstations")
}

model MachineThroughput {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  machineId      String   @map("machine_id")
  productId      String   @map("product_id")
  maxThroughput  Decimal  @default(0) @map("max_throughput") @db.Decimal(19, 4)
  idleThroughput Decimal  @default(0) @map("idle_throughput") @db.Decimal(19, 4)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([machineId, productId])
  @@index([tenantId])
  @@map("machine_throughputs")
}

model Machine {
  id            String      @id @default(uuid())
  tenantId      String      @map("tenant_id")
  workstationId String?     @map("workstation_id")
  code          String
  name          String
  modelNumber   String?     @map("model_number")
  manufacturer  String?
  serialNumber  String?     @map("serial_number")
  watts         Int?
  year          Int?
  posX          Float       @default(80) @map("pos_x")
  posY          Float       @default(80) @map("pos_y")
  width         Float       @default(176)
  height        Float       @default(72)
  rotation      Float       @default(0)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workstation   Workstation?        @relation(fields: [workstationId], references: [id], onDelete: SetNull)
  throughputs   MachineThroughput[]
  captures      MachineCapture[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("machines")
}

model BankReconciliation {
  id                      String                    @id @default(uuid())
  tenantId                String                    @map("tenant_id")
  accountId               String                    @map("account_id")
  startDate               DateTime                  @map("start_date")
  endDate                 DateTime                  @map("end_date")
