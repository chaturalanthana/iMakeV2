}

model ProductionCalendarEvent {
  id             String        @id @default(uuid())
  tenantId       String        @map("tenant_id")
  type           String
  date           DateTime
  name           String
  description    String?
  shiftPatternId String?       @map("shift_pattern_id")
  workCenterId   String?       @map("work_center_id")
