  createdBy    String?         @map("created_by")
  createdAt    DateTime        @default(now()) @map("created_at")
  fund         PettyCashFund?  @relation(fields: [fundId], references: [id])
  settlements  IouSettlement[]
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, reference])
  @@index([tenantId])
  @@map("iou_advances")
}

model IouSettlement {
  id               String     @id @default(uuid())
  tenantId         String     @map("tenant_id")
  iouId            String     @map("iou_id")
  date             DateTime
  amount           Decimal    @db.Decimal(19, 4)
  kind             String
  expenseAccountId String?    @map("expense_account_id")
  description      String?
  createdBy        String?    @map("created_by")
  createdAt        DateTime   @default(now()) @map("created_at")
  iou              IouAdvance @relation(fields: [iouId], references: [id], onDelete: Cascade)
  tenant           Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([iouId])
  @@map("iou_settlements")
}

model RecurringJournal {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  active      Boolean  @default(true)
  lines       Json
  createdAt   DateTime @default(now()) @map("created_at")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("recurring_journals")
}

model PeriodClose {
  id              String            @id @default(uuid())
  tenantId        String            @map("tenant_id")
  year            Int
  month           Int
  status          String            @default("OPEN")
  exceptionReason String?           @map("exception_reason")
  createdAt       DateTime          @default(now()) @map("created_at")
  steps           PeriodCloseStep[]
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, year, month])
  @@index([tenantId])
  @@map("period_closes")
}

model PeriodCloseStep {
  id          String      @id @default(uuid())
  tenantId    String      @map("tenant_id")
  closeId     String      @map("close_id")
  code        String
  name        String
  sequence    Int
  status      String      @default("PENDING")
  note        String?
  completedAt DateTime?   @map("completed_at")
  close       PeriodClose @relation(fields: [closeId], references: [id], onDelete: Cascade)
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([closeId, code])
  @@index([tenantId])
  @@map("period_close_steps")
}

// Company is the tenant. Branch → warehouse → bin is the inventory hierarchy (SCP-03).
model Branch {
  id         String      @id @default(uuid())
  tenantId   String      @map("tenant_id")
  code       String
  name       String
  address    String?
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now()) @map("created_at")
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouses Warehouse[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

model Bin {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  warehouseId String    @map("warehouse_id")
  code        String
  name        String
  binType     String    @default("STORAGE") @map("bin_type")
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([tenantId, warehouseId, code])
  @@index([tenantId])
  @@map("bins")
}

model UomTemplate {
  id        String            @id @default(uuid())
  tenantId  String            @map("tenant_id")
  code      String
  name      String
  baseCode  String            @map("base_code")
  createdAt DateTime          @default(now()) @map("created_at")
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines     UomTemplateLine[]
  products  Product[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("uom_templates")
}

model UomTemplateLine {
  id           String      @id @default(uuid())
  tenantId     String      @map("tenant_id")
  templateId   String      @map("template_id")
  uomCode      String      @map("uom_code")
  factorToBase Decimal     @map("factor_to_base") @db.Decimal(19, 6)
  template     UomTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([templateId, uomCode])
  @@index([tenantId])
  @@map("uom_template_lines")
}

model ItemSupplier {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  productId  String   @map("product_id")
  supplierId String   @map("supplier_id")
  approved   Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, productId, supplierId])
  @@index([tenantId])
  @@map("item_suppliers")
}

model Pallet {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  warehouseId    String   @map("warehouse_id")
  code           String
  status         String   @default("ACTIVE")
  supersededById String?  @map("superseded_by_id")
  supersedesId   String?  @map("supersedes_id")
  createdAt      DateTime @default(now()) @map("created_at")
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  supersededBy   Pallet?  @relation("PalletChain", fields: [supersededById], references: [id], onDelete: SetNull)
  predecessors   Pallet[] @relation("PalletChain")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("pallets")
}

model StockBatch {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  productId          String    @map("product_id")
  lotNumber          String    @map("lot_number")
  expiryDate         DateTime? @map("expiry_date") @db.Date
  originalExpiryDate DateTime? @map("original_expiry_date") @db.Date
  manufacturedDate   DateTime? @map("manufactured_date") @db.Date
  status             String    @default("UNRESTRICTED")
  qaReleaseDate      DateTime? @map("qa_release_date") @db.Date
  retestDate         DateTime? @map("retest_date") @db.Date
  retestStatus       String    @default("NONE") @map("retest_status")
  proposedExpiry     DateTime? @map("proposed_expiry") @db.Date
  receiptDate        DateTime  @default(now()) @map("receipt_date")
  supplierId         String?   @map("supplier_id")
  notes              String?
  createdAt          DateTime  @default(now()) @map("created_at")
  product            Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier           Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  retests            QaRetest[]
  finishedGenealogy  BatchGenealogy[] @relation("GenealogyFgBatch")
  materialGenealogy  BatchGenealogy[] @relation("GenealogyRmBatch")
  machineCaptures    MachineCapture[] @relation("CaptureBatch")

  @@unique([tenantId, productId, lotNumber])
  @@index([tenantId])
  @@map("stock_batches")
}

model QaRetest {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  batchId         String    @map("batch_id")
  originalExpiry  DateTime? @map("original_expiry") @db.Date
  proposedExpiry  DateTime  @map("proposed_expiry") @db.Date
  status          String    @default("PROPOSED")
  evidence        String?
  requestedBy     String?   @map("requested_by")
  decidedBy       String?   @map("decided_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  decidedAt       DateTime? @map("decided_at")
  batch           StockBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([batchId])
  @@map("qa_retests")
}

model StockAllocation {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  productId    String    @map("product_id")
  warehouseId  String?   @map("warehouse_id")
  batchId      String?   @map("batch_id")
  sourceType   String    @map("source_type")
  sourceId     String    @map("source_id")
  sourceLineId String?   @map("source_line_id")
  kind         String
  quantity     Decimal   @db.Decimal(19, 4)
  releasedQty  Decimal   @default(0) @map("released_qty") @db.Decimal(19, 4)
  status       String    @default("OPEN")
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, productId])
  @@index([tenantId, sourceType, sourceId])
  @@map("stock_allocations")
}

model MaterialRequest {
  id                String                @id @default(uuid())
  tenantId          String                @map("tenant_id")
  number            String                @map("mr_number")
  date              DateTime
  requiredDate      DateTime?             @map("required_date")
  requestingParty   String                @map("requesting_party")
  purpose           String?
  sourceWarehouseId String                @map("source_warehouse_id")
  destWarehouseId   String?               @map("dest_warehouse_id")
  kind              String
  status            String                @default("DRAFT")
  approvalStatus    String                @default("PENDING") @map("approval_status")
  createdAt         DateTime              @default(now()) @map("created_at")
  createdBy         String?               @map("created_by")
  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceWarehouse   Warehouse             @relation("MrSource", fields: [sourceWarehouseId], references: [id])
  destWarehouse     Warehouse?            @relation("MrDest", fields: [destWarehouseId], references: [id])
  items             MaterialRequestItem[]
  pickLists         PickList[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@map("material_requests")
}

model MaterialRequestItem {
  id           String          @id @default(uuid())
  tenantId     String          @map("tenant_id")
  mrId         String          @map("mr_id")
  productId    String          @map("product_id")
  quantity     Decimal         @db.Decimal(19, 4)
  fulfilledQty Decimal         @default(0) @map("fulfilled_qty") @db.Decimal(19, 4)
  mr           MaterialRequest @relation(fields: [mrId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id])
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([mrId])
  @@map("material_request_items")
}

model PickList {
  id        String         @id @default(uuid())
  tenantId  String         @map("tenant_id")
  mrId      String         @map("mr_id")
  number    String
  status    String         @default("DRAFT")
  createdAt DateTime       @default(now()) @map("created_at")
  mr        MaterialRequest @relation(fields: [mrId], references: [id], onDelete: Cascade)
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines     PickListLine[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@map("pick_lists")
}

model PickListLine {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  pickListId   String   @map("pick_list_id")
  productId    String   @map("product_id")
  batchId      String?  @map("batch_id")
  palletId     String?  @map("pallet_id")
  suggestedQty Decimal  @map("suggested_qty") @db.Decimal(19, 4)
  confirmedQty Decimal  @default(0) @map("confirmed_qty") @db.Decimal(19, 4)
  pickList     PickList @relation(fields: [pickListId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id])
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([pickListId])
  @@map("pick_list_lines")
}

model InventoryTransfer {
  id              String                  @id @default(uuid())
  tenantId        String                  @map("tenant_id")
  number          String                  @map("transfer_number")
  date            DateTime
  fromWarehouseId String                  @map("from_warehouse_id")
  toWarehouseId   String                  @map("to_warehouse_id")
  mrId            String?                 @map("mr_id")
  mode            String                  @default("IMMEDIATE")
  status          String                  @default("DRAFT")
  reason          String?
  createdAt       DateTime                @default(now()) @map("created_at")
  createdBy       String?                 @map("created_by")
  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromWarehouse   Warehouse               @relation("InvXferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse     Warehouse               @relation("InvXferTo", fields: [toWarehouseId], references: [id])
  items           InventoryTransferItem[]
  legs            InventoryTransferLeg[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@map("inventory_transfers")
}

model InventoryTransferItem {
  id         String            @id @default(uuid())
  tenantId   String            @map("tenant_id")
  transferId String            @map("transfer_id")
  productId  String            @map("product_id")
  quantity   Decimal           @db.Decimal(19, 4)
  batchId    String?           @map("batch_id")
  palletId   String?           @map("pallet_id")
  uomId      String?           @map("uom_id")
  unitCost   Decimal           @default(0) @map("unit_cost") @db.Decimal(19, 4)
  transfer   InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product    Product           @relation(fields: [productId], references: [id])
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([transferId])
  @@map("inventory_transfer_items")
}

model InventoryTransferLeg {
  id                String            @id @default(uuid())
  tenantId          String            @map("tenant_id")
  transferId        String            @map("transfer_id")
  productId         String            @map("product_id")
  batchId           String?           @map("batch_id")
  palletId          String?           @map("pallet_id")
  quantity          Decimal           @db.Decimal(19, 4)
  quantityRemaining Decimal           @map("quantity_remaining") @db.Decimal(19, 4)
  unitCost          Decimal           @map("unit_cost") @db.Decimal(19, 4)
  transfer          InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product           Product           @relation(fields: [productId], references: [id])
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([transferId])
  @@map("inventory_transfer_legs")
}

model StockReturn {
  id          String            @id @default(uuid())
  tenantId    String            @map("tenant_id")
  number      String            @map("return_number")
  date        DateTime
  kind        String
  customerId  String?           @map("customer_id")
  supplierId  String?           @map("supplier_id")
  warehouseId String            @map("warehouse_id")
  reference   String?
  status      String            @default("DRAFT")
  createdAt   DateTime          @default(now()) @map("created_at")
  createdBy   String?           @map("created_by")
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplier    Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id])
  items       StockReturnItem[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@map("stock_returns")
}

model StockReturnItem {
  id          String      @id @default(uuid())
  tenantId    String      @map("tenant_id")
  returnId    String      @map("return_id")
  productId   String      @map("product_id")
  quantity    Decimal     @db.Decimal(19, 4)
  batchId     String?     @map("batch_id")
  reason      String
  disposition String
  unitCost    Decimal     @default(0) @map("unit_cost") @db.Decimal(19, 4)
  stockReturn StockReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id])
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([returnId])
  @@map("stock_return_items")
}

model CycleCount {
  id            String           @id @default(uuid())
  tenantId      String           @map("tenant_id")
  number        String           @map("count_number")
  warehouseId   String           @map("warehouse_id")
  date          DateTime
  kind          String           @default("CYCLE")
  status        String           @default("DRAFT")
  financeStatus String           @default("PENDING") @map("finance_status")
  notes         String?
  createdAt     DateTime         @default(now()) @map("created_at")
  createdBy     String?          @map("created_by")
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse     Warehouse        @relation(fields: [warehouseId], references: [id])
  lines         CycleCountLine[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@map("cycle_counts")
}

model CycleCountLine {
  id            String     @id @default(uuid())
  tenantId      String     @map("tenant_id")
  countId       String     @map("count_id")
  productId     String     @map("product_id")
  batchId       String?    @map("batch_id")
  bookQty       Decimal    @map("book_qty") @db.Decimal(19, 4)
  countQty      Decimal    @map("count_qty") @db.Decimal(19, 4)
  recountQty    Decimal?   @map("recount_qty") @db.Decimal(19, 4)
  reason        String?
  varianceQty   Decimal    @default(0) @map("variance_qty") @db.Decimal(19, 4)
  varianceValue Decimal    @default(0) @map("variance_value") @db.Decimal(19, 4)
  unitCost      Decimal    @default(0) @map("unit_cost") @db.Decimal(19, 4)
  cycleCount    CycleCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  product       Product    @relation(fields: [productId], references: [id])
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([countId])
  @@map("cycle_count_lines")
}



