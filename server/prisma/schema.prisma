model BOM {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  productId    String    @map("product_id")
  code         String
  name         String
  version      String    @default("1.0")
  status       String    @default("DRAFT")
  isDefault    Boolean   @default(false) @map("is_default")
  description  String?
  routingSteps Json?     @default("[]") @map("routing_steps")
  totalCost    Decimal   @default(0.0) @map("total_cost") @db.Decimal(19, 4)
  effectiveFrom DateTime? @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  createdBy    String?   @map("created_by")
  activatedAt  DateTime? @map("activated_at")
  activatedBy  String?   @map("activated_by")
  
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product      Product   @relation("ProductBOMs", fields: [productId], references: [id])
  items        BOMItem[]
  resources    BOMResource[]
  productionJobs ProductionJob[]
  productionOrders ProductionOrder[]

  @@unique([tenantId, productId, code])
  @@unique([tenantId, productId, version])
  @@index([tenantId])
  @@map("boms")
}

model BOMItem {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  bomId            String   @map("bom_id")
  productId        String   @map("product_id")
  quantity         Decimal  @db.Decimal(19, 4)
  scrapPercent     Decimal  @default(0.0) @map("scrap_percent") @db.Decimal(19, 4)
  instruction      String?
  type             String   @default("Raw Material")
  
  bom              BOM      @relation(fields: [bomId], references: [id], onDelete: Cascade)
  componentProduct Product  @relation("BOMComponentProducts", fields: [productId], references: [id])

  @@index([tenantId])
  @@map("bom_items")
}

model BOMResource {
  id        String   @id @default(uuid())
