  chequeNumber       String?                   @map("cheque_number")
  description        String?
  amount             Decimal                   @db.Decimal(19, 4)
  isMatched          Boolean                   @default(false) @map("is_matched")
  createdAt          DateTime                  @default(now()) @map("created_at")
