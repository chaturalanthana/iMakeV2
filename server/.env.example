# Copy to server/.env for local API development.
# JWT_SECRET and DATABASE_URL are required. The old hardcoded JWT fallback was public and must be rotated.

PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://imake_user:replace-with-a-long-random-password@localhost:5432/imake_db
JWT_SECRET=replace-with-a-long-random-secret
