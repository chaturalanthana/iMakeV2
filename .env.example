# Copy to .env before `docker compose up`.
# The previous database password was committed in a public repository and must be rotated.

POSTGRES_USER=imake_user
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=imake_db
POSTGRES_PORT=5432

# Used by the optional app service: docker compose --profile app up
DATABASE_URL=postgresql://imake_user:replace-with-a-long-random-password@postgres:5432/imake_db
JWT_SECRET=replace-with-a-long-random-secret
APP_PORT=5000
